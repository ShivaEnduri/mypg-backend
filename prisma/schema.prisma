generator client {
  provider = "prisma-client-js"
  output   = "../generated/pg"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model dy_invoices {
  id               Int                @id @default(autoincrement())
  inv_id           String             @unique(map: "Inv_Id") @db.VarChar(20)
  booking_id       Int
  inv_amount       Decimal            @db.Decimal(10, 2)
  inv_cgst         Decimal            @db.Decimal(10, 2)
  inv_sgst         Decimal            @db.Decimal(10, 2)
  inv_total        Decimal            @db.Decimal(10, 2)
  inv_datetime     DateTime           @db.DateTime(0)
  inv_duedate      DateTime           @db.DateTime(0)
  inv_from_date    DateTime           @db.DateTime(0)
  inv_to_date      DateTime           @db.DateTime(0)
  inv_generated_by Int
  dy_pg_bookings   dy_pg_bookings     @relation(fields: [booking_id], references: [id], onDelete: Cascade, map: "dy_invoice-fk_booking_id")
  dy_user          dy_user            @relation(fields: [inv_generated_by], references: [id], onDelete: Cascade, map: "dy_invoice-fk_user_id")
  dy_payments_info dy_payments_info[]

  @@index([booking_id], map: "dy_invoice-fk_booking_ID_idx")
  @@index([inv_generated_by], map: "dy_invoice-fk_user_id_idx")
  @@index([booking_id], map: "fk_booking_id_idx")
}

model dy_payments_info {
  id                         Int            @id @default(autoincrement())
  payment_id                 String         @unique(map: "Payment_Id") @db.VarChar(35)
  inv_id                     Int
  payment_mode_id            Int
  razor_pay_order_id         String?        @db.VarChar(50)
  razor_pay_payment_datetime DateTime?      @db.DateTime(0)
  payment_status             Int?
  cash_payment               Decimal?       @db.Decimal(10, 2)
  actual_payment             Decimal?       @db.Decimal(10, 2)
  balance                    Decimal?       @db.Decimal(10, 2)
  payment_date               DateTime?      @db.DateTime(0)
  remarks                    String?        @db.VarChar(100)
  st_pg_pay_mode             st_pg_pay_mode @relation(fields: [payment_mode_id], references: [id], onDelete: Cascade, map: "dy_payment_info_fk_payment_mode")
  dy_invoices                dy_invoices    @relation(fields: [inv_id], references: [id], onDelete: Cascade, map: "dy_payments_info-fk_inv_id")
  st_pg_cur_sts              st_pg_cur_sts? @relation(fields: [payment_status], references: [id], onDelete: Cascade, map: "dy_payments_info_fk_pay_status")
  dy_receipts                dy_receipts[]

  @@index([payment_mode_id], map: "dy_payment_info_fk_payment_mode_idx")
  @@index([inv_id], map: "dy_payments_info-fk_inv_id")
  @@index([payment_status], map: "dy_payments_info_fk_pay_status_idx")
}

model dy_pg_alerts {
