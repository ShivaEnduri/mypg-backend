  dy_pg_info           dy_pg_info           @relation(fields: [pg_id], references: [id], onDelete: Cascade, map: "fk_alert_new_pg")
  st_pg_alert_priority st_pg_alert_priority @relation(fields: [alert_priority], references: [id], onDelete: Cascade, map: "fk_alert_new_priority")
  dy_user              dy_user?             @relation(fields: [alert_receiver], references: [id], onDelete: Cascade, map: "fk_alert_new_receiver")
  st_pg_role           st_pg_role           @relation(fields: [alert_receiver_role], references: [id], onDelete: Cascade, map: "fk_alert_new_role")
  st_pg_cur_sts        st_pg_cur_sts        @relation(fields: [alert_status], references: [id], onDelete: Cascade, map: "fk_alert_new_status")

