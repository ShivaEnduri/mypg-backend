  @@index([alert_priority], map: "fk_alert_new_priority_idx")
  @@index([alert_receiver], map: "fk_alert_new_receiver_idx")
  @@index([alert_receiver_role], map: "fk_alert_new_role_idx")
  @@index([alert_status], map: "fk_alert_new_status_idx")
